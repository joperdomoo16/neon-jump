rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow anyone to read the leaderboard (necessary to show the ranking)
    match /leaderboard/{userId} {
      allow read: if true;
      
      // Permitir creación por primera vez
      allow create: if request.auth != null 
                   && request.auth.uid == userId
                   && isValidScoreData(request.resource.data);
                   
      // Permitir actualización (el puntaje nunca puede ser menor al anterior)
      allow update: if request.auth != null 
                   && request.auth.uid == userId
                   && isValidScoreData(request.resource.data)
                   && request.resource.data.score >= resource.data.score;
    }
    
    // Helper function to validate leaderboard data
    function isValidScoreData(data) {
      // hasOnly previene que inyecten campos basura como isAdmin
      return data.keys().hasOnly(['playerName', 'score', 'timestamp', 'expiresAt'])
             && data.score is int 
             && data.score >= 0 
             && data.score <= 500000
             && data.playerName is string 
             && data.playerName.size() > 0 
             && data.playerName.size() <= 20
             && data.timestamp == request.time
             && data.expiresAt is timestamp;
    }
  }
}
